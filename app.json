{
  "expo": {
    "name": "MyBudgetApp",
    "slug": "MyBudgetApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shingyeeang.mybudgetapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#005B54"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.shingyeeang.mybudgetapp",
      "scheme": "mybudgetapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "mybudgetapp"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgetName": "MyBudgetWidgets",
          "ios": {
            "useNse": false
          },
          "widgets": [
            {
              "name": "InfoWidget",
              "label": "Budget Overview",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "Shows today's spending and the current monthly budget.",
              "previewImage": "./assets/adaptive-icon.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ActionWidget",
              "label": "Quick Add",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Opens expense entry.",
              "previewImage": "./assets/adaptive-icon.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-quick-actions",
      "expo-notifications"
    ]
  }
}
